# ===== Servidor =====
PORT=3000

# ===== Base de datos MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=smartplant

# ===== JWT =====
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ===== Google OAuth 2.0 =====
# Crea credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# ===== CORS =====
FRONTEND_URL=http://localhost:5173

# ===== Correo (Gmail + Nodemailer) =====
# EMAIL_APP_PASSWORD se genera en https://myaccount.google.com/apppasswords
# (requiere verificación en 2 pasos activada en la cuenta de Gmail)
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=

# ===== PayPhone =====
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# ===== PayPal (Sandbox) =====
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ===== Suscripción Premium =====
PREMIUM_PRECIO_USD=4.99

# ===== Asistente IA (Ollama local) =====
# Requiere tener Ollama corriendo localmente: https://ollama.com
# y haber descargado el modelo con: ollama pull qwen2.5:0.5b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
